{
  "name": "aizuda",
  "type": "module",
  "version": "1.0.1",
  "private": true,
  "description": "Rapidly build applications like building blocks with low or even zero code.",
  "homepage": "https://gitee.com/aizuda/flowlong",
  "keywords": [
    "aizuda",
    "FlowLong",
    "Vue3 admin ",
    "vue-admin-template",
    "Vite6",
    "TypeScript",
    "naive-ui",
    "naive-ui-admin",
    "UnoCSS"
  ],
  "engines": {
    "node": ">=18.20.0",
    "pnpm": ">=8.7.0"
  },
  "scripts": {
    "build": "vite build --mode prod",
    "build:dev": "vite build --mode dev",
    "build:test": "vite build --mode test",
    "cleanup": "sa cleanup",
    "commit": "sa git-commit",
    "commit:zh": "sa git-commit -l=zh-cn",
    "dev": "vite --mode dev",
    "dev:prod": "vite --mode prod",
    "dev:test": "vite --mode test",
    "gen-route": "sa gen-route",
    "lint": "eslint . --fix",
    "prepare": "simple-git-hooks",
    "preview": "vite preview",
    "release": "sa release",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "update-pkg": "sa update-pkg"
  },
  "dependencies": {
    "@better-scroll/core": "2.5.1",
    "@iconify/utils": "^3.1.7",
    "@iconify/vue": "5.0.5",
    "@sa/axios": "workspace:*",
    "@sa/color": "workspace:*",
    "@sa/hooks": "workspace:*",
    "@sa/materials": "workspace:*",
    "@sa/utils": "workspace:*",
    "@vueuse/core": "13.9.0",
    "clipboard": "2.0.11",
    "dayjs": "1.11.23",
    "defu": "6.1.7",
    "echarts": "5.6.0",
    "event-source-polyfill": "^1.0.31",
    "json5": "2.2.3",
    "monaco-editor": "^0.57.0",
    "naive-ui": "2.45.3",
    "nprogress": "0.2.0",
    "pinia": "3.0.4",
    "print-js": "1.6.0",
    "tailwind-merge": "3.7.1",
    "ts-md5": "^1.3.1",
    "vue": "3.5.46",
    "vue-draggable-plus": "0.6.1",
    "vue-i18n": "11.4.23",
    "vue-router": "4.6.5"
  },
  "devDependencies": {
    "@elegant-router/vue": "0.3.8",
    "@iconify/json": "2.2.559",
    "@sa/scripts": "workspace:*",
    "@sa/uno-preset": "workspace:*",
    "@soybeanjs/eslint-config": "1.7.5",
    "@types/node": "22.20.5",
    "@types/nprogress": "0.2.3",
    "@unocss/eslint-config": "66.13.0",
    "@unocss/preset-icons": "66.13.0",
    "@unocss/preset-uno": "66.13.0",
    "@unocss/preset-wind3": "66.13.0",
    "@unocss/transformer-directives": "66.13.0",
    "@unocss/transformer-variant-group": "66.13.0",
    "@unocss/vite": "66.13.0",
    "@vitejs/plugin-vue": "5.2.4",
    "@vitejs/plugin-vue-jsx": "4.2.0",
    "axios": "1.21.1",
    "consola": "3.4.2",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.12.1",
    "kolorist": "1.8.0",
    "prettier-plugin-json-sort": "0.0.2",
    "sass": "1.108.2",
    "simple-git-hooks": "2.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unplugin-icons": "22.5.0",
    "unplugin-vue-components": "28.8.0",
    "vite": "6.4.6",
    "vite-plugin-monaco-editor-esm": "2.0.3",
    "vite-plugin-progress": "0.0.7",
    "vite-plugin-svg-icons": "2.0.1",
    "vite-plugin-vue-devtools": "7.7.10",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "2.2.12"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm sa git-commit-verify",
    "pre-commit": "pnpm typecheck && pnpm lint && git diff --exit-code"
  },
  "github": "https://github.com/aizuda/flowlong",
  "website": "https://aizuda.com"
}
